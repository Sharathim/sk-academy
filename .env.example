# SK Academic and Excellence - Environment Variables Configuration
# Copy this file to .env or .env.local to configure communication channels

# Academy Contact Phone (When activated, displays in header, footer, and contact section)
VITE_ACADEMY_PHONE=

# Academy WhatsApp Number with Country Code (e.g., 919876543210 for India)
# When configured, enquiry form submissions will automatically open WhatsApp with the drafted message
VITE_WHATSAPP_NUMBER=

# Academy Official Email Address
VITE_ACADEMY_EMAIL=

